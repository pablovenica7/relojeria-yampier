# Copiá este archivo a .env y completá los valores reales:
#   cp .env.example .env
#
# El backend carga este archivo automáticamente al arrancar (usando godotenv),
# tanto en desarrollo local como si corrés `go run ./cmd/api` directo. En Docker no
# hace falta: docker-compose ya inyecta las variables por environment: y, si
# existiera un .env, igual no pisa las que vengan del entorno del contenedor.
#
# .env NUNCA se sube a git (ver .gitignore).

# En el hosting (Render) PORT lo define la plataforma: no hace falta cargarlo.
PORT=8080

# Origen(es) del frontend que pueden llamar a la API, separados por coma.
# Producción: solo URLs HTTPS propias, ej.
#   ALLOWED_ORIGIN=https://relojeriayampier.com,https://www.relojeriayampier.com
ALLOWED_ORIGIN=http://localhost:5173

# Local (sin Docker): mongodb://localhost:27017
# Producción: connection string de MongoDB Atlas (mongodb+srv://...), cargada
# SOLO como secreto del hosting, nunca en un archivo del repositorio.
# Con docker-compose: mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=relojeria_yampier

# Obligatorio: el backend NO arranca si esta variable está vacía.
# Generá una clave larga y aleatoria, por ejemplo con: openssl rand -hex 32
JWT_SECRET=

# Usuario admin que se crea automáticamente la primera vez que arranca el backend
# (solo si no existe ya un admin con ese email).
ADMIN_EMAIL=admin@relojeriayampier.com
ADMIN_PASSWORD=cambiar-esta-password

# development | production. Con APP_ENV=production NUNCA se cargan datos demo,
# aunque SEED_DEMO_DATA quede en true por error.
APP_ENV=development

# true solo en desarrollo: carga 6 relojes Casio de demostración UNA sola vez
# por base (queda una marca en la colección app_meta; reiniciar no los vuelve
# a insertar). No borra ni modifica datos existentes.
SEED_DEMO_DATA=true

# IPs/CIDR de proxies propios (ej. Nginx) cuyo X-Forwarded-For es confiable.
# Vacío = se usa solo la IP de la conexión (no se confía en X-Forwarded-For).
TRUSTED_PROXIES=

# Intervalo del vencimiento automático de reservas (30s, 5m, 1h; mínimo 10s).
RESERVATION_SWEEP_INTERVAL=5m

# Las imágenes subidas desde el Admin se guardan en MongoDB (GridFS). Esta
# carpeta solo se lee al arrancar para migrar imágenes de versiones anteriores.
UPLOADS_DIR=./uploads

# URL pública del sitio (para armar enlaces en emails, ej. recuperar contraseña).
APP_PUBLIC_URL=http://localhost:5173

# Envío de emails: smtp | log (SOLO desarrollo: escribe el email en el log) | vacío (no envía).
MAIL_DRIVER=log
# Solo si MAIL_DRIVER=smtp. Completar con las credenciales reales del proveedor
# de correo (nunca en este archivo de ejemplo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
