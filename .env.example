# Copiá este archivo a .env en la raíz del proyecto antes de correr docker-compose:
#   cp .env.example .env
# .env NUNCA se sube a git.

ALLOWED_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api

# Contacto comercial del frontend (ver frontend/.env.example). Vacíos = no se muestran.
# WhatsApp: solo dígitos con código de país, ej. 549351XXXXXXX (solo si está confirmado).
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=

# Obligatorio: el backend no arranca si queda vacío. Generá una clave larga,
# por ejemplo con: openssl rand -hex 32
JWT_SECRET=

ADMIN_EMAIL=admin@relojeriayampier.com
ADMIN_PASSWORD=cambiar-esta-password

# Entorno: development | production. En Docker, si no se define, vale
# "production" (seguro por defecto). Con production, SEED_DEMO_DATA se ignora.
APP_ENV=development

# true solo para ver el sitio con relojes Casio de demostración (desarrollo/demo).
# Se cargan UNA sola vez por base de datos; nunca borra datos existentes.
# En un despliegue real: SEED_DEMO_DATA=false y APP_ENV=production.
SEED_DEMO_DATA=true

# Proxies propios cuyo X-Forwarded-For se acepta (IPs o CIDR separados por coma).
# Vacío = se ignora X-Forwarded-For (correcto si el backend se expone directo).
# Ejemplo detrás de Nginx en la red de Docker: TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# Cada cuánto se vencen reservas cuyo plazo pasó (además del vencimiento
# inmediato al usar el Admin). Formato Go: 30s, 5m, 1h. Mínimo 10s.
RESERVATION_SWEEP_INTERVAL=5m

# URL pública del sitio (enlaces en emails) y envío de emails (ver backend/.env.example).
APP_PUBLIC_URL=http://localhost:5173
# En Docker por defecto no se envían emails. "log" solo funciona fuera de producción.
MAIL_DRIVER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
